{
  "info": {
    "name": "Scrapbook Widget Backend API",
    "description": "Quick API testing collection for Scrapbook Widget Backend.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:3000/api/v1"
    },
    {
      "key": "idToken",
      "value": ""
    },
    {
      "key": "userId",
      "value": "sampleUserId"
    },
    {
      "key": "friendId",
      "value": "sampleFriendId"
    },
    {
      "key": "groupId",
      "value": "sampleGroupId"
    },
    {
      "key": "pageId",
      "value": "samplePageId"
    },
    {
      "key": "messageId",
      "value": "sampleMessageId"
    },
    {
      "key": "templateId",
      "value": "sampleTemplateId"
    }
  ],
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{idToken}}",
        "type": "string"
      }
    ]
  },
  "item": [
    {
      "name": "Auth",
      "item": [
        {
          "name": "Register",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"john@example.com\",\n  \"password\": \"secret123\",\n  \"displayName\": \"John Doe\",\n  \"username\": \"john_doe\",\n  \"nickname\": \"John\",\n  \"avatarUrl\": \"https://example.com/avatar.jpg\",\n  \"status\": \"active\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/auth/register",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "auth",
                "register"
              ]
            }
          }
        },
        {
          "name": "Login",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"john@example.com\",\n  \"password\": \"secret123\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/auth/login",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "auth",
                "login"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const responseJson = pm.response.json();",
                  "if (responseJson && responseJson.idToken) {",
                  "  pm.environment.set('idToken', responseJson.idToken);",
                  "}"
                ]
              }
            }
          ]
        },
        {
          "name": "Session",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"idToken\": \"{{idToken}}\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/auth/session",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "auth",
                "session"
              ]
            }
          }
        },
        {
          "name": "Signout",
          "request": {
            "method": "POST",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/auth/signout",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "auth",
                "signout"
              ]
            }
          }
        },
        {
          "name": "Delete Account",
          "request": {
            "method": "DELETE",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/auth/account",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "auth",
                "account"
              ]
            }
          }
        }
      ]
    },
